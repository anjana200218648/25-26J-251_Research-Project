# Example Environment Configuration
# Copy this file to .env and fill in your actual values

# PostgreSQL Configuration
DATABASE_URL=postgresql+psycopg2://postgres:123123123@localhost:5432/maindgard2
# JWT Secret Key
SECRET_KEY=your-super-secret-key-change-this-in-production
# Ollama model selection for Sinhala complaint text analysis

OLLAMA_SINHALA_PRIMARY_MODEL=qwen2.5:3b
# Comma-separated fallback models in priority order
OLLAMA_SINHALA_FALLBACKS=qwen:7b,mistral,llama3.2:3b,llama3.2:1b,gemma2:2b
